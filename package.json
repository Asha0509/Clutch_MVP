{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && pnpm --filter clutch-functions typecheck",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-clutch \"vitest run --config vitest.rules.config.ts\"",
    "e2e": "pnpm --filter clutch-functions build && firebase emulators:exec --only auth,firestore,functions --project demo-clutch \"playwright test\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "catalogue:check": "tsx scripts/check-catalogue.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^13.3.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
